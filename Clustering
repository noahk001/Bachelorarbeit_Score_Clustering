import pandas as pd
import matplotlib.pyplot as plt
from sklearn.cluster import KMeans
from sklearn.preprocessing import StandardScaler
import scipy.cluster.hierarchy as sch
from sklearn.cluster import AgglomerativeClustering

file = 'Medical_data'

def run_patient_clustering(file_path, output_file, n_clusters=4):
    df = pd.read_csv(file_path, sep=';', decimal=',', skiprows=1)

    ids = df['id']
    X = df.drop(columns=['id'])
    scaler = StandardScaler()
    X_scaled = scaler.fit_transform(X)
    kmeans = KMeans(n_clusters=n_clusters, random_state=42, n_init=10)
    cluster_labels = kmeans.fit_predict(X_scaled)
    df['Cluster'] = cluster_labels
    df.to_csv(output_file, index=False, sep=';', decimal=',')
    print(f"Analyse erfolgreich! Datei wurde unter '{output_file}' gespeichert.")
    print(f"Gefundene Cluster-Verteilung:\n{df['Cluster'].value_counts().sort_index()}")

run_patient_clustering(file, 'Patienten_kmeans_Ergebnis.csv', n_clusters=4)

def run_hierarchical_clustering(file, output_file):
    df = pd.read_csv(file, sep=';', decimal=',')
    df.columns = [str(c).lower().strip() for c in df.columns]
    if 'id' not in df.columns:
        print(f"FEHLER: 'id' fehlt. Gefundene Spalten sind: {list(df.columns)}")
        raise KeyError("Spalte 'id' ist nicht in der Datei!")

    ids = df['id']
    X = df.drop(columns=['id'])
    scaler = StandardScaler()
    X_scaled = scaler.fit_transform(X)

    plt.figure(figsize=(12, 7))
    dendrogram = sch.dendrogram(
        sch.linkage(X_scaled, method='ward'),
        labels=ids.values,
        leaf_rotation=90.,
        leaf_font_size=10.
    )
    plt.title('Dendrogramm der Patienten-Ähnlichkeit')
    plt.xlabel('Patienten (Index)')
    plt.ylabel('Euklidische Distanz')
    plt.savefig('Dendrogramm.png')
    plt.show()
    hc = AgglomerativeClustering(n_clusters=3, metric='euclidean', linkage='ward')
    cluster_labels = hc.fit_predict(X_scaled)

    df['Hierarchical_Cluster'] = cluster_labels
    df.to_csv(output_file, index=False, sep=';', decimal=',')

    print(f"Hierarchisches Clustering abgeschlossen. Datei '{output_file}' erstellt.")
    return df

run_hierarchical_clustering(file, 'Patienten_Hierarchisch_Ergebnis.csv')
